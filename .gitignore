# Virtual environment - recreate it with requirements.txt, never commit it
.venv/

# Downloaded and generated satellite data. Several GB, and GitHub caps files at
# 100 MB. The dataset is delivered as a separate download; README.md carries the
# link and acquisition/ regenerates everything from scratch.
data/
data.zip

# Trained model weights. Delivered separately alongside the dataset, for the
# same reason. weights/_not_submitted/ holds resume state no marker needs.
weights/

# Scan caches written by the notebooks, keyed by a hash of the file list. They
# are rebuilt on demand and are not results.
outputs/**/counts_*.json
outputs/**/sample_*.json
outputs/**/tiles_*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Keep the figures used in the README, even though they live under data/
!docs/images/

# Working notes and decision records - kept local, not published
decision.md
